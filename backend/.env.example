# --- System / Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# Format: postgresql+psycopg://username:password@host:port/database_name
DATABASE_URL=postgresql+psycopg://postgres:yourpassword@localhost:5432/rag_db

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Embedding Model ---
# Local sentence-transformers model — no API key required
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Expected output dimension for EMBEDDING_MODEL.
EMBEDDING_DIMENSIONS=384

# --- ChromaDB ---
# Directory where ChromaDB persists vector data
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_COLLECTION_NAME=document_chunks

# --- Retrieval / RAG ---
TOP_K=4
SIMILARITY_THRESHOLD=0.35
MAX_CONTEXT_LENGTH=6000
CHAT_HISTORY_MESSAGE_LIMIT=10

# --- Evaluation ---
EVAL_TOP_K=4
EVAL_DATASET_PATH=./evaluation/dataset.json
EVAL_OUTPUT_PATH=./evaluation/reports/latest_report.json
EVAL_USE_LLM_JUDGE=false
EVAL_LLM_JUDGE_MODEL=llama-3.3-70b-versatile

# --- LLM ---
LLM_PROVIDER=groq
# Groq model options: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it
LLM_MODEL=llama-3.3-70b-versatile
# Get your free Groq API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- Authentication ---
# Generate a secret with: backend/env/Scripts/python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
