# PostgreSQL Connection Database URL
# Format: postgresql+psycopg://username:password@host:port/database_name
DATABASE_URL=postgresql+psycopg://postgres:yourpassword@localhost:5432/rag_db

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Embedding Model ---
# Local sentence-transformers model — no API key required
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Expected output dimension for EMBEDDING_MODEL. Change both values together
# and re-index into a fresh collection when changing models.
EMBEDDING_DIMENSIONS=384

# --- ChromaDB ---
# Path to the directory where ChromaDB persists vector data
# (relative paths are resolved from the backend/ directory)
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_COLLECTION_NAME=document_chunks

# --- Retrieval / RAG ---
TOP_K=4
# Minimum accepted cosine similarity after converting ChromaDB cosine distance
# using similarity = 1 - distance.
SIMILARITY_THRESHOLD=0.35
MAX_CONTEXT_LENGTH=6000

# --- LLM ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
# Obtain this from your provider and keep it only in backend/.env.
OPENAI_API_KEY=your_openai_api_key_here
