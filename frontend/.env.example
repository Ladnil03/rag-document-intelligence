# Frontend environment — copy to .env.local for local dev.
# Vite only exposes variables prefixed with VITE_ to the browser bundle.

# Base URL of the FastAPI backend. The browser fetches from this URL.
# Local dev (vite on :5173, FastAPI on :8000):
#   VITE_API_URL=http://localhost:8000
# Production via docker-compose (nginx reverse-proxies /api/* to web:8000):
#   VITE_API_URL=/api
#
# Do NOT put the GROQ_API_KEY here. That key lives only in backend/.env
# and never crosses into the browser bundle.
VITE_API_URL=http://localhost:8000
